# Copy these into Vercel → Project → Settings → Environment Variables.
# None of them belong in the repo, and none of them reach the browser: every call to
# Supabase and PayPal is made by the functions in /api.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://sifxwjvvhlyiosvcwfwm.supabase.co
# service_role key (Settings → API). Full access, bypasses RLS. Server only. Never ship this
# to a client, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── PayPal ──────────────────────────────────────────────────────────────────
# 'sandbox' while you are testing, 'live' when you are taking real money.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From Developer Dashboard → your app → Webhooks. Needed to verify that a webhook really
# came from PayPal; without it the endpoint refuses every call.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# ── Site ────────────────────────────────────────────────────────────────────
# Used to build PayPal's return and cancel URLs. No trailing slash.
SITE_URL=https://brandmyporche1.vercel.app
# How long a zone is held while someone is at the PayPal checkout.
HOLD_MINUTES=20

# ── Receipts (optional) ─────────────────────────────────────────────────────
RESEND_API_KEY=
RECEIPT_FROM=Brand My 911 <hello@brandmy911.com>
