# Copy these into Vercel → Project → Settings → Environment Variables.
# None of them belong in the repo, and none of them reach the browser: every call to
# Supabase and PayPal is made by the functions in /api.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://sifxwjvvhlyiosvcwfwm.supabase.co
# service_role key (Settings → API). Full access, bypasses RLS. Server only. Never ship this
# to a client, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── PayPal ──────────────────────────────────────────────────────────────────
# 'sandbox' while you are testing, 'live' when you are taking real money.
#
# All four of these are per-environment. Sandbox and live are separate dashboards with
# separate apps, separate key pairs and separate webhooks — a live client ID will be rejected
# by sandbox and vice versa, which reads as "Client Authentication failed". When you switch
# this to live you must replace the other three at the same time.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Developer Dashboard → your app → Webhooks → the ID of the webhook pointing at
# https://<your-domain>/api/paypal-webhook. Without it the endpoint refuses every call, which
# is deliberate: an unverified webhook could mark the hood sold.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# ── Site ────────────────────────────────────────────────────────────────────
# Used to build PayPal's return and cancel URLs. No trailing slash.
SITE_URL=https://brandmyporche1.vercel.app
# How long a zone is held while someone is at the PayPal checkout.
HOLD_MINUTES=20

# ── Receipts (optional) ─────────────────────────────────────────────────────
RESEND_API_KEY=
RECEIPT_FROM=Brand My 911 <hello@brandmy911.com>

# ── Trying the site out without paying ───────────────────────────────────────
# Set this on a preview deployment and the whole flow runs with no PayPal account and no
# money: the zone is really held, the artwork is really uploaded, the price still comes from
# the server, and the logo really goes on the car. Only the payment is skipped.
# The page carries a permanent banner while it is on, and /api/demo-reset?redirect=1 clears
# every demo purchase. NEVER set this on the production deployment.
# DEMO_MODE=1
